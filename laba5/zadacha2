
N = int(input("Введите количество чисел: "))

p = 1
k = 0
count = 0

for i in range(N):
    x = int(input("Введите число: "))

    if 0 < x <= 100:
        p *= x
        k += 1

    if x < -50:
        count += 1

if k > 0:
    print("Среднее геометрическое:", p ** (1 / k))
else:
    print("Положительных чисел, не превышающих 100, нет")

print("Количество отрицательных элементов:", count)
